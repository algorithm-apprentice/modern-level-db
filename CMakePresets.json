{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-debug",
      "displayName": "Development Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MODERN_LEVELDB_BUILD_TESTS": "ON",
        "MODERN_LEVELDB_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MODERN_LEVELDB_BUILD_TESTS": "ON",
        "MODERN_LEVELDB_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "compatibility",
      "displayName": "Extended Compatibility Harness",
      "inherits": "dev-debug",
      "binaryDir": "${sourceDir}/build/compatibility",
      "cacheVariables": {
        "MODERN_LEVELDB_BUILD_EXTENDED_TESTS": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "LLVM Fuzzing",
      "inherits": "dev-debug",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "MODERN_LEVELDB_BUILD_TESTS": "OFF",
        "MODERN_LEVELDB_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "--coverage -fprofile-update=atomic",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "MODERN_LEVELDB_BUILD_TESTS": "ON",
        "MODERN_LEVELDB_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "compatibility",
      "configurePreset": "compatibility"
    },
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    }
  ],
  "testPresets": [
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "fuzz"
        }
      }
    },
    {
      "name": "compatibility",
      "configurePreset": "compatibility",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "model|compatibility|crash"
        }
      }
    },
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    }
  ]
}
