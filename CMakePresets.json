{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-debug",
      "displayName": "Development Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MODERN_LEVELDB_BUILD_TESTS": "ON",
        "MODERN_LEVELDB_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MODERN_LEVELDB_BUILD_TESTS": "ON",
        "MODERN_LEVELDB_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "compatibility",
      "displayName": "Extended Compatibility Harness",
      "inherits": "dev-debug",
      "binaryDir": "${sourceDir}/build/compatibility",
      "cacheVariables": {
        "MODERN_LEVELDB_BUILD_EXTENDED_TESTS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Address and Undefined Behavior Sanitizers",
      "inherits": "compatibility",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "Thread Sanitizer",
      "inherits": "compatibility",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "benchmarks",
      "displayName": "Release Performance Baseline",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/benchmarks",
      "cacheVariables": {
        "MODERN_LEVELDB_BUILD_TESTS": "OFF",
        "MODERN_LEVELDB_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "profiling",
      "displayName": "Optimized Benchmark and Profiling",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/profiling",
      "cacheVariables": {
        "MODERN_LEVELDB_BUILD_TESTS": "OFF",
        "MODERN_LEVELDB_BUILD_PERFORMANCE_TESTS": "ON",
        "CMAKE_C_FLAGS": "-g -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-g -fno-omit-frame-pointer",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "LLVM Fuzzing",
      "inherits": "dev-debug",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "MODERN_LEVELDB_BUILD_TESTS": "OFF",
        "MODERN_LEVELDB_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "--coverage -fprofile-update=atomic",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "MODERN_LEVELDB_BUILD_TESTS": "ON",
        "MODERN_LEVELDB_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "profiling",
      "configurePreset": "profiling"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "benchmarks",
      "configurePreset": "benchmarks"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "compatibility",
      "configurePreset": "compatibility"
    },
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    }
  ],
  "testPresets": [
    {
      "name": "profiling",
      "configurePreset": "profiling",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "performance"
        }
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit|model|compatibility|crash"
        }
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit|model"
        }
      }
    },
    {
      "name": "benchmarks",
      "configurePreset": "benchmarks",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "benchmark"
        }
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "fuzz"
        }
      }
    },
    {
      "name": "compatibility",
      "configurePreset": "compatibility",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "model|compatibility|crash"
        }
      }
    },
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    }
  ]
}
